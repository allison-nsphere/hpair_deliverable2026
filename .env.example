# ─────────────────────────────────────────────────────────────────────────────
# HPAIR Personal Info Form — configuration
#
#   1. cp .env.example .env
#   2. Fill in the three values from https://dashboard.emailjs.com
#   3. Restart the dev server (Create React App only reads .env at startup)
#
# There is no database. On submit, one email is sent: the confirmation to the
# applicant. That send IS the submission — if it fails, the user is kept on the
# form rather than shown a false success.
#
# To keep a copy for HPAIR, set a BCC address in the EmailJS template settings.
#
# These values are inlined into the JS bundle and are visible to anyone who
# loads the page. That is expected for the EmailJS *public* key — restrict the
# account with the allowed-domains setting in the EmailJS dashboard.
# Never put an EmailJS *private* key here.
# ─────────────────────────────────────────────────────────────────────────────

# Account → General → Public Key
REACT_APP_EMAILJS_PUBLIC_KEY=

# Email Services → Service ID
REACT_APP_EMAILJS_SERVICE_ID=

# Email Templates → Template ID.
# The template's "To email" field MUST be {{to_email}} — the app supplies the
# applicant's address. Set Reply-To to {{email}} if you want replies to reach them.
REACT_APP_EMAILJS_TEMPLATE_ID=

# Attach the CV file itself to the email.
# Requires a PAID EmailJS plan with a Variable Attachment using {{cv_base64}}.
# On the free plan leave this false — the variable size limit is far smaller
# than any real CV, and enabling it would make those submissions fail.
# When false, the email still reports the CV's filename and size.
REACT_APP_EMAILJS_ATTACH_CV=false

# ─────────────────────────────────────────────────────────────────────────────
# Template variables:
#
#   {{to_email}}         — recipient; set as the template's "To email"
#   {{reference}}        — short reference code, e.g. HP-K3F9QA2
#   {{submitted_at}}     — local timestamp
#   {{name}} {{first_name}} {{last_name}}
#   {{email}}            — the applicant's email address
#   {{mailing_address}} {{phone}}
#   {{nationality}} {{preferred_language}} {{favorite_dish}}
#   {{heard_about_us}}   — includes their free text when they chose "Other"
#   {{linkedin_url}}     — or "Not shared"
#   {{cv_name}}          — or "Not shared"
#   {{cv_size}}          — e.g. "248 KB"
#   {{anything_else}}    — or "Nothing else shared"
#
# Only when REACT_APP_EMAILJS_ATTACH_CV=true (paid plans):
#   {{cv_base64}}        — file content, for a Variable Attachment
#   {{cv_mime}}          — the file's MIME type
# ─────────────────────────────────────────────────────────────────────────────
